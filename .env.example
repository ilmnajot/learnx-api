# Copy to .env for local overrides. .env is ignored by git, so real secrets stay out of the repository.

# Enables the Claude tutor. Without it, the built-in rule-based tutor is used.
ANTHROPIC_API_KEY=

# Optional overrides
# LEARNX_AI_MODEL=claude-opus-5-5
# LEARNX_AI_DAILY_LIMIT=50
# LEARNX_AI_GLOBAL_DAILY_LIMIT=1000

# Optional locally: without a mail server, emails and their links are written to the server log.
# LEARNX_PUBLIC_URL=http://localhost:5173

# Required in production (SPRING_PROFILES_ACTIVE=prod). Startup fails without them.
# LEARNX_DB_URL=jdbc:postgresql://host:5432/learnx
# LEARNX_DB_USERNAME=
# LEARNX_DB_PASSWORD=
# LEARNX_JWT_SECRET=at-least-32-random-characters
# LEARNX_ALLOWED_ORIGINS=https://app.example.com
# LEARNX_PUBLIC_URL=https://app.example.com
# LEARNX_MAIL_FROM=LearnX <no-reply@app.example.com>
# LEARNX_SMTP_HOST=smtp.your-provider.example
# LEARNX_SMTP_PORT=587
# LEARNX_SMTP_USERNAME=
# LEARNX_SMTP_PASSWORD=

# Become admins once their email is confirmed. Comma separated.
# LEARNX_ADMIN_EMAILS=you@example.com
